{
  "name": "@drillgram/web",
  "license": "Apache-2.0",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter tidy-layout build:engine && vite",
    "build": "run-p typecheck \"build-only {@}\" --",
    "preview": "vite preview",
    "test:unit": "pnpm --filter tidy-layout build:engine && vitest",
    "test": "pnpm --filter tidy-layout build:engine && vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "build-only": "pnpm --filter tidy-layout build:engine && vite build",
    "typecheck": "vue-tsc --build",
    "generate-pwa-assets": "pwa-assets-generator"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@github/markdown-toolbar-element": "^2.2.3",
    "@lucide/vue": "^1.77.0",
    "@drillgram/model": "workspace:*",
    "@tailwindcss/vite": "^4.3.5",
    "@vueuse/core": "^15.0.0",
    "@xyflow/vue": "^2.0.2",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "markdown-it": "^15.0.3",
    "reka-ui": "^2.11.0",
    "shadcn-vue": "^2.9.0",
    "tailwindcss": "^4.3.5",
    "tidy-layout": "workspace:*",
    "tw-animate-css": "^1.4.0",
    "vue": "^3.5.42",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@thesvg/static": "4.0.14",
    "@tsconfig/node24": "^24.0.5",
    "@types/jsdom": "^30.0.0",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^24.13.4",
    "@vite-pwa/assets-generator": "^2.0.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.5.0",
    "@vue/tsconfig": "^0.9.1",
    "fast-check": "^4.10.3",
    "jsdom": "^30.0.1",
    "npm-run-all2": "^9.0.3",
    "typescript": "~6.0.0",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^2.0.0",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.11",
    "workbox-window": "^7.4.1"
  },
  "engines": {
    "node": "^22.22.2 || >=24.15.0"
  }
