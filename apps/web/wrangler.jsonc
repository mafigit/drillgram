// The browser-only app and its optional MCP relay. See context/operations.md ("On Cloudflare").
{
  "name": "drillgram",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist-browser",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/mcp", "/api/agent/socket"]
  },
  "durable_objects": {
    "bindings": [{ "name": "AGENT_SESSIONS", "class_name": "AgentSession" }]
  },
  "migrations": [{ "tag": "agent-session-v1", "new_sqlite_classes": ["AgentSession"] }]
}
