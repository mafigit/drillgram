#!/usr/bin/env bash
# The full check, as CI runs it: no private address in a file (bin/public-check), then unit
# tests, typecheck, the licence gate and the e2e journeys in the pinned Playwright image
# (apps/web/e2e/Dockerfile), without network, then the licence of every file
# (deploy/licences/reuse). Needs Docker; run from anywhere.
#
#   bin/ci-check           all of it, one part after the other: what to run before a push
#   bin/ci-check <part>    one part, as CI runs them side by side (.github/workflows/ci.yml):
#                            image         builds the check's image, and no more
#                            unit          the private-address scan, unit tests, typecheck,
#                                          the licence gate, the licence of every file
#                            chromium, webkit, tablet, browser-only
#                                          the journeys of that Playwright project
#   bin/ci-check <project> <n>/<of>
#                          one share of a project's journeys, as Playwright cuts them
#                          (`--shard`): CI runs the slow projects as two jobs
#
# The image is built for the run and removed after it. With DRILLGRAM_CI_IMAGE set, the image
# of that name is used and kept instead: `image` builds it, the other parts expect it there.
# So several parts share one build (CI: a step builds, the next one checks).
set -euo pipefail
cd "$(dirname "$0")/.."

part=${1:-all}
shard=${2:-}
case "$part" in
  all | image | unit | chromium | webkit | tablet | browser-only) ;;
  *)
    echo "ci-check: there is no part \"$part\". The parts: image, unit, chromium, webkit, tablet, browser-only; none of them for the whole check." >&2
    exit 2
    ;;
esac
case "$part $shard" in
  *' ') ;;
  chromium\ [1-9]/[1-9] | webkit\ [1-9]/[1-9] | tablet\ [1-9]/[1-9] | browser-only\ [1-9]/[1-9]) ;;
  *)
    echo "ci-check: \"$shard\" is no share of \"$part\". A share is <n>/<of>, as in: bin/ci-check tablet 1/2" >&2
    exit 2
    ;;
esac

build() { bin/docker-build --network host -f apps/web/e2e/Dockerfile -t "$img" .; }
# Inside the image, without a network: what a test asks outside the machine fails.
inside() { docker run --rm --init --ipc=host --network none "$img" sh -ec "$1"; }

kept=${DRILLGRAM_CI_IMAGE:-}
img=$kept
if [ -z "$img" ]; then
  img="drillgram-ci-$$-$RANDOM"
  trap 'docker rmi -f "$img" >/dev/null 2>&1 || true' EXIT
fi

# First, and at once: nothing in the files that the public repository must not say.
case "$part" in all | unit) bin/public-check ;; esac

if [ -z "$kept" ] || [ "$part" = image ]; then
  build
elif ! docker image inspect "$img" >/dev/null 2>&1; then
  echo "ci-check: the image \"$img\" (DRILLGRAM_CI_IMAGE) is not there. Build it first: bin/ci-check image" >&2
  exit 1
fi

case "$part" in
  image) ;;
  all)
    # The journeys a project after the other, as CI runs them side by side: in one run of all
    # projects, the workers of WebKit (5 times slower a step than Chromium on Linux) starve, and
    # the longest journeys run out of time (J42 on the tablet over 30 s, alone 7 s; 2026-11-26).
    # WebKit with fewer workers too: as fast in all, J42 14 s instead of 24 (14 cores, busy).
    inside 'pnpm test && pnpm typecheck && pnpm licences
      failed=
      for project in chromium webkit tablet phone browser-only; do
        case $project in webkit | tablet) workers=--workers=30% ;; *) workers= ;; esac
        pnpm test:e2e --project=$project $workers || failed="$failed $project"
      done
      if [ -n "$failed" ]; then echo "ci-check: journeys failed in:$failed" >&2; exit 1; fi'
    deploy/licences/reuse
    ;;
  unit)
    inside 'pnpm test && pnpm typecheck && pnpm licences'
    deploy/licences/reuse
    ;;
  *)
    inside "pnpm test:e2e --project=$part${shard:+ --shard=$shard}"
    ;;
esac
