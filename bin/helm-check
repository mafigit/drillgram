#!/usr/bin/env bash
# The chart's tests (Kyverno Chainsaw, https://kyverno.github.io/chainsaw): deploy/helm/tests,
# one folder each, every test in a namespace of its own that goes afterwards. Run against a
# disposable Kubernetes cluster that has the hosted image loaded; the Helm workflow makes one
# with kind. Needs helm, kubectl, chainsaw, curl and bash.
#
#   bin/helm-check [chart] [image]
#
# chart: a folder or a packaged archive (default: deploy/helm/drillgram); image: the hosted
# image as repository:tag (default: drillgram:helm-test).
set -euo pipefail
cd "$(dirname "$0")/.."

chart=$(realpath "${1:-deploy/helm/drillgram}")
image=${2:-drillgram:helm-test}
export CHART=$chart IMAGE_REPOSITORY=${image%:*} IMAGE_TAG=${image##*:}
# One test after the other: both releases pull PostgreSQL and start the app on a small cluster.
exec chainsaw test --test-dir deploy/helm/tests --parallel 1
