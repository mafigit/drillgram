#!/usr/bin/env bash
# Fails when a file of the repository says what the public repository must not say: an address
# of a private network, a host of a local domain, or the open port of a Docker daemon. Such
# things belong in context/private/ (in .gitignore). bin/ci-check and bin/publish run it; see
# docs/agents/publishing.md. Checks the commit given (default HEAD), not the working tree.
set -euo pipefail
cd "$(dirname "$0")/.."
commit=${1:-HEAD}

octet='[0-9]{1,3}'
private="(10\.$octet|192\.168|172\.(1[6-9]|2[0-9]|3[01]))\.$octet\.$octet"
pattern="(^|[^0-9.])$private([^0-9.]|\$)|[A-Za-z0-9-]+\.local\.[A-Za-z]|:2375([^0-9]|\$)"
# Pictures and lock files hold runs of numbers that only look like addresses; this file names
# the port it looks for.
if found=$(git grep -n -I -E "$pattern" "$commit" -- . ':!*.svg' ':!pnpm-lock.yaml' ':!*Cargo.lock' ':!bin/public-check'); then
  echo "$found" | cut -c1-200 >&2
  echo "public-check: FAIL: the lines above name a private address or host. Move that to context/private/ (see docs/agents/publishing.md)." >&2
  exit 1
fi
echo "public-check: OK"
