{
  "name": "drillgram",
  "license": "Apache-2.0",
  "private": true,
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": "^22.22.2 || >=24.15.0"
  },
  "scripts": {
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @drillgram/web test:e2e",
    "test:e2e:ui": "pnpm --filter @drillgram/web test:e2e:ui",
    "typecheck": "pnpm -r typecheck",
    "licences": "pnpm --filter @drillgram/licences check",
    "build": "pnpm -r build"
  }
}
